{
  "expo": {
    "name": "Rabin Photography",
    "slug": "rabin-photography-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/rabins-logo.png",
    "scheme": "rabinapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/rabins-logo.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.sudip004.client",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#1A0D0E",
        "translucent": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rabins-logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0d",
          "dark": {
            "backgroundColor": "#0d0d0d"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd214cf6-447f-412e-8c41-aa1b1a739aff"
      }
    }
  }
}